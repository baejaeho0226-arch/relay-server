const express = require('express');
const cors = require('cors');

const app = express();
app.use(cors());
app.use(express.json());

const commands = {};
const notifies = {};

app.get('/', (req, res) => {
    res.send('Relay Server is Running!');
});

app.post('/send_command', (req, res) => {
    const { roomId, command } = req.body;
    if (roomId && command) {
        commands[roomId] = command;
        console.log(`[>] Command '${command}' stored for room: ${roomId}`);
        return res.status(200).send({ status: 'ok' });
    }
    res.status(400).send({ error: 'invalid data' });
});

app.get('/poll', (req, res) => {
    const roomId = req.query.roomId;
    if (roomId && commands[roomId]) {
        const cmd = commands[roomId];
        delete commands[roomId];
        console.log(`[<] Command '${cmd}' consumed by C++ from room: ${roomId}`);
        return res.send(cmd);
    }
    res.send('');
});

app.post('/send_notify', (req, res) => {
    const { roomId, message } = req.body;
    if (roomId && message) {
        notifies[roomId] = message;
        console.log(`[>] Notify '${message}' stored for room: ${roomId}`);
        return res.status(200).send({ status: 'ok' });
    }
    res.status(400).send({ error: 'invalid data' });
});

app.get('/poll_notify', (req, res) => {
    const roomId = req.query.roomId;
    if (roomId && notifies[roomId]) {
        const msg = notifies[roomId];
        delete notifies[roomId];
        console.log(`[<] Notify '${msg}' consumed by App from room: ${roomId}`);
        return res.send(msg);
    }
    res.send('');
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`=== RELAY SERVER RUNNING ON PORT ${PORT} ===`);
});
